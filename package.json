{
  "name": "next-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 2020",
    "dev:clean": "rd /s /q .next && npm run dev",
    "build": "next build --turbopack",
    "build:clean": "rd /s /q .next 2>nul & npm run build",
    "clean": "rd /s /q .next",
    "clean:all": "rd /s /q .next && rd /s /q node_modules",
    "start": "next start -p 2021",
    "start:back": "node scripts/server/startup.js -p 2021",
    "stop:back": "node scripts/server/stop.js",
    "reboot:back": "node scripts/server/reboot.js -p 2021",
    "log:clear": "node scripts/log/clear.js",
    "log:clear:force": "node scripts/log/clear.js --force",
    "log:clear:prod": "node scripts/log/clear.js --prod",
    "log:clear:prod:force": "node scripts/log/clear.js --force --prod",
    "log": "node scripts/log/index.js",
    "log:tail": "node scripts/log/index.js --lines=20",
    "log:all": "node scripts/log/index.js --lines=100",
    "log:prod": "node scripts/log/index.js --prod",
    "log:prod:tail": "node scripts/log/index.js --prod --lines=50",
    "task:update": "node scripts/task/taskUpdate.js",
    "task:list": "node scripts/task/taskList.js",
    "task:delete": "node scripts/task/taskDelete.js",
    "task:prod:update": "node scripts/task/taskUpdate.js --prod",
    "task:prod:list": "node scripts/task/taskList.js --prod",
    "task:prod:delete": "node scripts/task/taskDelete.js --prod"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "mongodb": "^6.20.0",
    "next": "15.5.5",
    "nodemailer": "^7.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hotkeys-hook": "^5.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4"
  }
}
